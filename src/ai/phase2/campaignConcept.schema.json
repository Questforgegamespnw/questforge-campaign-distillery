{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://questforgegamespnw.com/schemas/campaign-concept.schema.json",
  "title": "QuestForge Phase 2 Campaign Concept Package",
  "description": "Normalized output contract for Phase 2 Campaign Concept Development.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "submissionId",
    "selectedIdentityDirection",
    "generationMode",
    "identitySummary",
    "concepts",
    "validationSummary"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "submissionId": {
      "type": "string",
      "minLength": 1
    },
    "selectedIdentityDirection": {
      "type": "string",
      "enum": [
        "primary",
        "adjacent",
        "wildcard"
      ]
    },
    "generationMode": {
      "type": "string",
      "enum": [
        "single",
        "three_variants"
      ],
      "default": "three_variants"
    },
    "identitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identityTitle",
        "identityPitch",
        "corePromise",
        "playEmphasis",
        "tone",
        "genre",
        "environment",
        "mustPreserve",
        "mustAvoid"
      ],
      "properties": {
        "identityTitle": {
          "type": "string",
          "minLength": 1
        },
        "identityPitch": {
          "type": "string",
          "minLength": 1
        },
        "corePromise": {
          "type": "string",
          "minLength": 1
        },
        "playEmphasis": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "environment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mustPreserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "mustAvoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "systemContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "preferredSystem",
        "systemsToAvoid"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "preferred",
            "open",
            "undecided"
          ]
        },
        "preferredSystem": {
          "type": "string"
        },
        "systemsToAvoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "settingContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "preferredSetting",
        "settingConstraints"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "preferred",
            "open",
            "undecided"
          ]
        },
        "preferredSetting": {
          "type": "string"
        },
        "settingConstraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "validationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaValid",
        "identityAligned",
        "inventionBoundariesRespected",
        "playablePremisePresent",
        "warnings"
      ],
      "properties": {
        "schemaValid": {
          "type": "boolean"
        },
        "identityAligned": {
          "type": "boolean"
        },
        "inventionBoundariesRespected": {
          "type": "boolean"
        },
        "playablePremisePresent": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generationMode": {
            "const": "single"
          }
        }
      },
      "then": {
        "properties": {
          "concepts": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generationMode": {
            "const": "three_variants"
          }
        }
      },
      "then": {
        "properties": {
          "concepts": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    }
  ],
  "$defs": {
    "factionOrForce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "wants",
        "pressureOnPlayers"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "wants": {
          "type": "string",
          "minLength": 1
        },
        "pressureOnPlayers": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "meaningfulChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "choice",
        "whatItChanges"
      ],
      "properties": {
        "choice": {
          "type": "string",
          "minLength": 1
        },
        "whatItChanges": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantType",
        "conceptTitle",
        "oneSentencePremise",
        "campaignPitch",
        "startingSituation",
        "centralConflict",
        "playersDo",
        "recurringCampaignEngine",
        "whyNow",
        "factionsOrForces",
        "escalation",
        "distinctiveElement",
        "meaningfulChoices",
        "hook"
      ],
      "properties": {
        "variantType": {
          "type": "string",
          "enum": [
            "core_interpretation",
            "alternate_situation",
            "distinctive_interpretation"
          ]
        },
        "conceptTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "oneSentencePremise": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "campaignPitch": {
          "type": "string",
          "minLength": 1
        },
        "startingSituation": {
          "type": "string",
          "minLength": 1
        },
        "centralConflict": {
          "type": "string",
          "minLength": 1
        },
        "playersDo": {
          "type": "string",
          "minLength": 1
        },
        "recurringCampaignEngine": {
          "type": "string",
          "minLength": 1
        },
        "whyNow": {
          "type": "string",
          "minLength": 1
        },
        "factionsOrForces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factionOrForce"
          },
          "minItems": 2,
          "maxItems": 6
        },
        "escalation": {
          "type": "string",
          "minLength": 1
        },
        "distinctiveElement": {
          "type": "string",
          "minLength": 1
        },
        "meaningfulChoices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/meaningfulChoice"
          },
          "minItems": 2,
          "maxItems": 5
        },
        "hook": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "systemImplementationNotes": {
          "type": "string"
        },
        "settingImplementationNotes": {
          "type": "string"
        }
      }
    }
  }
}