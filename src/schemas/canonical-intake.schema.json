{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuestForge Canonical Intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "group",
    "preferences",
    "notes",
    "boundaries",
    "safety",
    "rawSignals",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "group": {
      "$ref": "#/$defs/group"
    },
    "preferences": {
      "$ref": "#/$defs/preferences"
    },
    "notes": {
      "$ref": "#/$defs/notes"
    },
    "boundaries": {
      "$ref": "#/$defs/boundaries"
    },
    "safety": {
      "$ref": "#/$defs/safety"
    },
    "rawSignals": {
      "$ref": "#/$defs/rawSignals"
    },
    "diagnostics": {
      "$ref": "#/$defs/diagnostics"
    },
    "matchmaking": {
      "$ref": "#/$defs/matchmaking"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "formId",
        "subject"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "website_form",
            "consult_notes",
            "manual_entry",
            "unknown"
          ]
        },
        "formId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "email",
        "respondentType",
        "groupSize",
        "currentGroupSize",
        "desiredGroupSize",
        "systemPreference",
        "audience",
        "ageBand"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "groupSize": {
          "type": "string"
        },
        "systemPreference": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "ageBand": {
          "type": "string",
          "enum": [
            "adult",
            "teens_14_17",
            "kids_11_13",
            "kids_8_10",
            "kids_5_7",
            "mixed_age",
            ""
          ]
        },
        "respondentType": {
          "type": "string",
          "enum": [
            "individual",
            "partial_group",
            "existing_group",
            "group_organizer",
            ""
          ]
        },
        "currentGroupSize": {
          "type": "string"
        },
        "desiredGroupSize": {
          "type": "string"
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiences",
        "setups",
        "tone",
        "choiceWeight",
        "genres",
        "eras",
        "aesthetics",
        "worldConditions",
        "environments",
        "gameplayInterests",
        "playerFantasy"
      ],
      "properties": {
        "experiences": {
          "$ref": "#/$defs/stringArray"
        },
        "setups": {
          "$ref": "#/$defs/stringArray"
        },
        "tone": {
          "type": "string"
        },
        "choiceWeight": {
          "type": "string"
        },
        "genres": {
          "$ref": "#/$defs/stringArray"
        },
        "environments": {
          "$ref": "#/$defs/stringArray"
        },
        "gameplayInterests": {
          "$ref": "#/$defs/stringArray"
        },
        "playerFantasy": {
          "$ref": "#/$defs/stringArray"
        },
        "eras": {
          "$ref": "#/$defs/stringArray"
        },
        "aesthetics": {
          "$ref": "#/$defs/stringArray"
        },
        "worldConditions": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mustHaves",
        "avoid",
        "campaignSummary"
      ],
      "properties": {
        "mustHaves": {
          "type": "string"
        },
        "avoid": {
          "type": "string"
        },
        "campaignSummary": {
          "type": "string"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contentBoundaries"
      ],
      "properties": {
        "contentBoundaries": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicitYouthMode",
        "audienceSuggestsYouth",
        "ageBandSuggestsYouth",
        "familyFriendlyBoundary",
        "textSuggestsYouth",
        "inferredYouthSafe",
        "youthSafeMode",
        "softYouthCueCount",
        "contradictionNotes",
        "experienceProfile",
        "contentSafetyMode",
        "audienceSuggestsKids",
        "audienceRequestsFamilyFriendly",
        "ageBandSuggestsKids",
        "textSuggestsKids",
        "softerThemesMode",
        "fullSafeMode",
        "heroKidsMode",
        "horrorRestricted",
        "graphicContentRestricted",
        "oppressiveToneRestricted"
      ],
      "properties": {
        "explicitYouthMode": {
          "type": "boolean"
        },
        "audienceSuggestsYouth": {
          "type": "boolean"
        },
        "ageBandSuggestsYouth": {
          "type": "boolean"
        },
        "familyFriendlyBoundary": {
          "type": "boolean"
        },
        "textSuggestsYouth": {
          "type": "boolean"
        },
        "inferredYouthSafe": {
          "type": "boolean"
        },
        "youthSafeMode": {
          "type": "boolean"
        },
        "softYouthCueCount": {
          "type": "integer",
          "minimum": 0
        },
        "contradictionNotes": {
          "$ref": "#/$defs/stringArray"
        },
        "experienceProfile": {
          "type": "string",
          "enum": [
            "standard",
            "youth",
            "kids"
          ]
        },
        "audienceSuggestsKids": {
          "type": "boolean"
        },
        "ageBandSuggestsKids": {
          "type": "boolean"
        },
        "textSuggestsKids": {
          "type": "boolean"
        },
        "softerThemesMode": {
          "type": "boolean"
        },
        "fullSafeMode": {
          "type": "boolean"
        },
        "heroKidsMode": {
          "type": "boolean"
        },
        "horrorRestricted": {
          "type": "boolean"
        },
        "graphicContentRestricted": {
          "type": "boolean"
        },
        "oppressiveToneRestricted": {
          "type": "boolean"
        },
        "contentSafetyMode": {
          "type": "string",
          "enum": [
            "standard",
            "restricted",
            "family_friendly",
            "full_kid_safe"
          ]
        },
        "audienceRequestsFamilyFriendly": {
          "type": "boolean"
        }
      }
    },
    "rawSignals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "youthMode",
        "audience",
        "ageBand",
        "contentBoundaries",
        "mustHaves",
        "avoid"
      ],
      "properties": {
        "youthMode": {
          "$ref": "#/$defs/stringArray"
        },
        "audience": {
          "type": "string"
        },
        "ageBand": {
          "type": "string"
        },
        "contentBoundaries": {
          "$ref": "#/$defs/stringArray"
        },
        "mustHaves": {
          "type": "string"
        },
        "avoid": {
          "type": "string"
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hasMinimumViableSignal",
        "contradictionNotes"
      ],
      "properties": {
        "hasMinimumViableSignal": {
          "type": "boolean"
        },
        "contradictionNotes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "nullableBoolean": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "availabilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "start",
        "end"
      ],
      "properties": {
        "day": {
          "type": "string",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday",
            ""
          ]
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "matchmaking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participation",
        "consent",
        "logistics",
        "commitment",
        "systems",
        "experience",
        "tablePreferences",
        "groupPreferences",
        "hardConstraints"
      ],
      "properties": {
        "participation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requested",
            "status",
            "source",
            "submissionReference"
          ],
          "properties": {
            "requested": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "enum": [
                "not_eligible",
                "not_asked",
                "declined",
                "opted_in",
                "conditional",
                "withdrawn"
              ]
            },
            "source": {
              "type": "string"
            },
            "submissionReference": {
              "type": "string"
            }
          }
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matchmaking",
            "profileRetention",
            "operatorReview",
            "contactForIntroduction",
            "shareableSummary"
          ],
          "properties": {
            "matchmaking": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "profileRetention": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "operatorReview": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "contactForIntroduction": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "shareableSummary": {
              "$ref": "#/$defs/nullableBoolean"
            }
          }
        },
        "logistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timezone",
            "playFormats",
            "availability",
            "frequencyPreferences",
            "sessionDuration",
            "scheduleFlexibility"
          ],
          "properties": {
            "timezone": {
              "type": "string"
            },
            "playFormats": {
              "$ref": "#/$defs/stringArray"
            },
            "availability": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/availabilityWindow"
              }
            },
            "frequencyPreferences": {
              "$ref": "#/$defs/stringArray"
            },
            "sessionDuration": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimumHours",
                "maximumHours"
              ],
              "properties": {
                "minimumHours": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "maximumHours": {
                  "$ref": "#/$defs/nullableNumber"
                }
              }
            },
            "scheduleFlexibility": {
              "type": "string"
            }
          }
        },
        "commitment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "campaignLengths",
            "attendanceExpectation",
            "startReadiness"
          ],
          "properties": {
            "campaignLengths": {
              "$ref": "#/$defs/stringArray"
            },
            "attendanceExpectation": {
              "type": "string"
            },
            "startReadiness": {
              "type": "string"
            }
          }
        },
        "systems": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preferred",
            "acceptable",
            "excluded",
            "openness"
          ],
          "properties": {
            "preferred": {
              "$ref": "#/$defs/stringArray"
            },
            "acceptable": {
              "$ref": "#/$defs/stringArray"
            },
            "excluded": {
              "$ref": "#/$defs/stringArray"
            },
            "openness": {
              "type": "string"
            }
          }
        },
        "experience": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "overallLevel",
            "systemsPlayed",
            "gmExperience",
            "mixedExperienceComfort"
          ],
          "properties": {
            "overallLevel": {
              "type": "string"
            },
            "systemsPlayed": {
              "$ref": "#/$defs/stringArray"
            },
            "gmExperience": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "mixedExperienceComfort": {
              "$ref": "#/$defs/nullableBoolean"
            }
          }
        },
        "tablePreferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roleplayIntensity",
            "tacticalIntensity",
            "rulesApproach",
            "characterCollaboration",
            "communicationStyles",
            "voiceRequired",
            "videoPreference"
          ],
          "properties": {
            "roleplayIntensity": {
              "type": "string"
            },
            "tacticalIntensity": {
              "type": "string"
            },
            "rulesApproach": {
              "type": "string"
            },
            "characterCollaboration": {
              "type": "string"
            },
            "communicationStyles": {
              "$ref": "#/$defs/stringArray"
            },
            "voiceRequired": {
              "$ref": "#/$defs/nullableBoolean"
            },
            "videoPreference": {
              "type": "string"
            }
          }
        },
        "groupPreferences": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumPlayers",
            "preferredPlayers",
            "maximumPlayers"
          ],
          "properties": {
            "minimumPlayers": {
              "$ref": "#/$defs/nullableNumber"
            },
            "preferredPlayers": {
              "$ref": "#/$defs/nullableNumber"
            },
            "maximumPlayers": {
              "$ref": "#/$defs/nullableNumber"
            }
          }
        },
        "hardConstraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schedule",
            "format",
            "content",
            "system",
            "commitment",
            "tableCulture",
            "freeText"
          ],
          "properties": {
            "schedule": {
              "$ref": "#/$defs/stringArray"
            },
            "format": {
              "$ref": "#/$defs/stringArray"
            },
            "content": {
              "$ref": "#/$defs/stringArray"
            },
            "system": {
              "$ref": "#/$defs/stringArray"
            },
            "commitment": {
              "$ref": "#/$defs/stringArray"
            },
            "tableCulture": {
              "$ref": "#/$defs/stringArray"
            },
            "freeText": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
