flowchart TD

%% =========================================================
%% QUESTFORGE CAMPAIGN DISTILLERY — PROGRAM ARCHITECTURE MAP
%% v0.9.x conceptual architecture
%%
%% IMPORTANT:
%% - Existing runtime names such as generateCampaignPitch remain unchanged.
%% - Current implemented output is conceptually Phase 1 Identity Pitches.
%% - Phase 2 Campaign Concept Development is the planned downstream layer.
%% =========================================================

classDef input fill:#eef6ff,stroke:#3b6ea5,stroke-width:1.5px,color:#0f2740
classDef process fill:#f7f7f7,stroke:#555,stroke-width:1.2px,color:#111
classDef decision fill:#fff5d9,stroke:#a56a00,stroke-width:1.5px,color:#4a2e00
classDef data fill:#edf9ef,stroke:#3d7a46,stroke-width:1.2px,color:#17361d
classDef ai fill:#f4ecff,stroke:#7251a6,stroke-width:1.5px,color:#2e174a
classDef validation fill:#ffecec,stroke:#a54343,stroke-width:1.3px,color:#4d1717
classDef artifact fill:#e8f8f8,stroke:#2f7d7d,stroke-width:1.3px,color:#143d3d
classDef human fill:#fff0f6,stroke:#a24f77,stroke-width:1.5px,color:#4f1830
classDef planned fill:#f0f0f0,stroke:#777,stroke-width:1.4px,stroke-dasharray: 6 4,color:#333
classDef legacy fill:#fffbe6,stroke:#9a7b00,stroke-width:1.1px,stroke-dasharray: 3 3,color:#4b3b00
classDef external fill:#eef2f5,stroke:#5c6873,stroke-width:1.2px,color:#202830

%% =========================================================
%% CLIENT / EXTERNAL INPUT
%% =========================================================
subgraph EXT["External Inputs and Client Interaction"]
    direction TB
    FORM["Client Intake Form<br/>Formspree / JSON / manual entry"]:::input
    HUMAN_NOTES["Optional Human Notes<br/>follow-up context, exclusions, service notes"]:::input
    CLIENT_REVIEW["Client Reviews Three Identity Directions"]:::human
    CLIENT_SELECTION["Identity Selection Record<br/>authoritative Phase 2 handoff"]:::human
    FINAL_CLIENT["Client Delivery<br/>PDFs + recommendation + next-step communication"]:::human
end

%% =========================================================
%% PHASE 1
%% =========================================================
subgraph P1["Phase 1 — Identity Discovery Pipeline (Implemented / Current Core)"]
    direction TB

    subgraph INTAKE["1. Intake and Canonicalization"]
        direction TB
        MAP["Form Mapping<br/>map raw field names and values"]:::process
        NORMALIZE["Normalization<br/>aliases, casing, punctuation, optional fields"]:::process
        CANONICAL["Canonical Intake Object<br/>controlled internal schema"]:::data
        CANON_VALID["Canonical Intake Validation<br/>AJV / schema boundary"]:::validation
        TRANSLATOR_INPUT["Translator Input Builder<br/>canonical → translation-ready shape"]:::process
    end

    subgraph INFERENCE["2. Safety, Profile, and Signal Interpretation"]
        direction TB
        SAFETY["Safety Signal Inference<br/>explicit, inferred, enforced"]:::process
        PROFILE["Experience / Audience Profile<br/>standard, youth-safe, complexity cues"]:::process
        TRANSLATE["Signal Translation<br/>human preferences → weighted internal signals"]:::process
        ADJUDICATE["Signal Adjudication<br/>priority, contradiction handling, suppression"]:::decision
        GUIDANCE["Handoff Guidance<br/>mustInclude, avoid, tone and audience guardrails"]:::data
    end

    subgraph SELECT["3. Direction Selection and Resolution"]
        direction TB
        DIRECTION_SELECT["Direction Selection<br/>Primary / Adjacent / Wildcard"]:::decision
        FRAME_SELECT["Frame and Skin Selection<br/>Core, System, Genre, Tone, Environment"]:::decision
        RESOLVE["ID Resolution<br/>IDs → complete data objects"]:::process
        RESOLVED_BUNDLE["Resolved Direction Bundles<br/>3 structured identity directions"]:::data
    end

    subgraph RENDER["4. Deterministic Identity Pitch Rendering"]
        direction TB
        PITCH_CORE["pitchCore<br/>context extraction and normalization"]:::process
        SECTION_BUILDERS["pitchSectionBuilders<br/>Title / About / Players Do / Distinct Hook"]:::process
        ASSEMBLY["pitchAssembly<br/>identity lead + support sentence composition"]:::process
        CLEANUP["pitchCleanup<br/>surface normalization and phrase cleanup"]:::process
        SAFETY_FILTERS["pitchSafetyFilters<br/>tone, youth-safe, and guardrail enforcement"]:::process
        GENERATOR["generateCampaignPitch<br/>legacy runtime name<br/>conceptual role: Identity Pitch renderer"]:::legacy
        IDENTITY_RAW["Deterministic Identity Pitch Output<br/>Primary / Adjacent / Wildcard"]:::data
    end

    subgraph POLISH["5. AI Identity Pitch Polish"]
        direction TB
        EXPANSION_INPUT["buildExpansionInput<br/>structured direction + deterministic backbone"]:::legacy
        PROMPT_EXPORT["Prompt Exporter<br/>provider-agnostic AI request"]:::artifact
        AI_POLISH["AI Identity Pitch Polish<br/>expression, flow, stylistic refinement"]:::ai
        RESPONSE_IMPORT["Response Parser / Importer<br/>JSON extraction and fallback handling"]:::process
        IDENTITY_VALID["Identity Pitch Validation<br/>structure, safety, scope, no concrete lore drift"]:::validation
        IDENTITY_FINAL["Polished Phase 1 Identity Pitches"]:::artifact
    end
end

%% =========================================================
%% HUMAN HANDOFF
%% =========================================================
subgraph HANDOFF["Human Selection Boundary"]
    direction TB
    SELECTION_SCHEMA["Identity Selection Record Schema<br/>selectedDirection, likedElements,<br/>elementsToAvoid, requestedChanges,<br/>systemDecision, settingDecision, notes"]:::data
    HANDOFF_VALID["Selection Record Validation"]:::validation
    PHASE2_INPUT["Normalized Phase 2 Input Package<br/>selected identity + intake + client refinements"]:::data
end

%% =========================================================
%% PHASE 2
%% =========================================================
subgraph P2["Phase 2 — Campaign Concept Development (Planned v0.9.x+)"]
    direction TB

    subgraph CONCEPT_INPUT["6. Concept Expansion Preparation"]
        direction TB
        IDENTITY_EXTRACT["Selected Identity Extraction<br/>preserve core promise and play emphasis"]:::planned
        SETTING_SYSTEM_CONTEXT["Optional Setting / System Context<br/>confirmed, preferred, open, or undecided"]:::planned
        INVENTION_BOUNDARY["Bounded Invention Contract<br/>what AI may and may not invent"]:::planned
        CONCEPT_PROMPT["Campaign Concept Expansion Prompt"]:::planned
    end

    subgraph CONCEPT_GEN["7. Campaign Concept Generation"]
        direction TB
        CONCEPT_AI["AI Campaign Concept Expansion<br/>adds playable premise and bounded fiction"]:::ai
        CONCEPT_VARIANTS["Concept Variant Strategy<br/>Core / Alternate Situation / Distinctive Interpretation"]:::planned
        NORMALIZED_CONCEPT["Normalized Campaign Concept Object"]:::data
    end

    subgraph CONCEPT_SCHEMA["8. Campaign Concept Contract"]
        direction TB
        TITLE["conceptTitle"]:::planned
        PREMISE["oneSentencePremise"]:::planned
        PITCH["campaignPitch"]:::planned
        START["startingSituation"]:::planned
        CONFLICT["centralConflict"]:::planned
        PLAYERS["playersDo"]:::planned
        ENGINE["recurringCampaignEngine"]:::planned
        WHYNOW["whyNow"]:::planned
        FACTIONS["factionsOrForces[]"]:::planned
        DISTINCTIVE["distinctiveElement"]:::planned
        HOOK["hook"]:::planned
    end

    subgraph CONCEPT_VALIDATE["9. Concept Validation"]
        direction TB
        STRUCT_VALID["Schema Validation<br/>required fields and types"]:::validation
        IDENTITY_ALIGN["Identity Alignment Validation<br/>no genre, tone, or playstyle contradiction"]:::validation
        INVENTION_VALID["Invention Boundary Validation<br/>no fixed ending, railroad, or excessive lore"]:::validation
        PLAYABLE_VALID["Playability Validation<br/>clear crisis, starting position, engine, escalation, choice"]:::validation
        CONCEPT_FINAL["Validated Campaign Concept Pitch(es)"]:::artifact
    end
end

%% =========================================================
%% SYSTEM RECOMMENDATION
%% =========================================================
subgraph SYSREC["System Recommendation Stage (Planned)"]
    direction TB
    REC_INPUT["Recommendation Inputs<br/>preferred system, identity, gameplay interests,<br/>tactical vs narrative emphasis, group experience,<br/>complexity tolerance, age profile, length, mechanics"]:::data
    REC_ENGINE["Recommendation Logic<br/>fit scoring + tradeoff comparison"]:::planned
    FAMILIAR["Primary Recommendation<br/>usually familiar / requested system"]:::artifact
    ALTERNATIVES["1–2 Mechanically Distinct Alternatives"]:::artifact
    REC_CONTRACT["Recommendation Output<br/>system, whyItFits, implementationNotes,<br/>howItChangesPlay, tradeoffs, confidence"]:::data
end

%% =========================================================
%% PDF / DELIVERY
%% =========================================================
subgraph DELIVERY["Client Deliverables and Export"]
    direction TB
    EXPORT_INPUT["Normalized Export Data<br/>never scrape prose from rendered documents"]:::data
    IDENTITY_PDF["Identity Pitch PDF Exporter<br/>combined 3-direction PDF<br/>optional individual direction PDFs"]:::artifact
    CONCEPT_PDF["Campaign Concept PDF Exporter<br/>reuses shared layout system"]:::planned
    REC_PDF["System Recommendation Section / PDF"]:::planned
    EMAILS["Email Templates<br/>intake receipt, Identity Pitch delivery,<br/>Campaign Concept delivery"]:::artifact
    DELIVERY_PACKAGE["Client Delivery Package"]:::artifact
end

%% =========================================================
%% SUPPORTING DATA SYSTEMS
%% =========================================================
subgraph SUPPORT["Supporting Libraries and Shared Systems"]
    direction TB

    subgraph LIBRARIES["Canonical Content Libraries"]
        direction TB
        CORE_LIB["Core Frame Library<br/>what the campaign means"]:::data
        SYSTEM_LIB["System Frame Library<br/>what players repeatedly do"]:::data
        GENRE_LIB["Genre / Setting Skins<br/>current overloaded narrative frame"]:::data
        TONE_LIB["Tone Skins<br/>emotional delivery"]:::data
        ENV_LIB["Environment Skins<br/>physical and spatial context"]:::data
        FRAME_DOC["Campaign Frame Library Documentation<br/>conceptual authority and pairing doctrine"]:::artifact
    end

    subgraph VOICE["Voice and Expression Systems"]
        direction TB
        VOICEMAP["voiceMap<br/>core, system, environment, genre, tone language pools"]:::data
        VOICE_RULES["Voice Doctrine<br/>clarity, one idea per sentence,<br/>variation without structural drift"]:::artifact
    end

    subgraph SAFETYMODEL["Safety and Constraint Systems"]
        direction TB
        SAFETY_MODEL["Safety Model<br/>explicit vs inferred vs enforced"]:::data
        YOUTH["Youth-Safe Interpretation Rules"]:::data
        EXCLUSIONS["Exclusions / Avoidance Signals"]:::data
    end

    subgraph SCHEMAS["Schemas and Contracts"]
        direction TB
        INTAKE_SCHEMA["Canonical Intake Schema"]:::data
        IDENTITY_SCHEMA["Identity Pitch Output Contract"]:::data
        SELECTION_RECORD_SCHEMA["Identity Selection Record Schema"]:::data
        CONCEPT_OUTPUT_SCHEMA["Campaign Concept Schema"]:::planned
        RECOMMENDATION_SCHEMA["System Recommendation Schema"]:::planned
    end
end

%% =========================================================
%% TESTING / AUDIT / OPERATIONS
%% =========================================================
subgraph OPS["Testing, Audit, and Operational Tooling"]
    direction TB
    FIXTURES["Test Fixtures / Form Samples"]:::external
    SMOKE["Core Frame Smoke Tests"]:::validation
    BATCH["Batch Form Tests<br/>coverage across archetypes"]:::validation
    E2E["End-to-End Form Flow Test"]:::validation
    AI_TEST["AI Expansion Tests"]:::validation
    AUDIT["Audit Output<br/>aiBrief, adjudicationSummary,<br/>confidence, suppressed signals"]:::artifact
    LOGGING["Debug Logging<br/>intake → mapping → selection → resolution → output"]:::artifact
    GITHUB["GitHub Issues / Roadmap"]:::external
    DOCS["Developer Documentation<br/>pipeline, renderer, voice, data model,<br/>debugging, expansion doctrine"]:::artifact
end

%% =========================================================
%% IMPLEMENTED PHASE 1 FLOW
%% =========================================================
FORM --> MAP
HUMAN_NOTES --> MAP
MAP --> NORMALIZE
NORMALIZE --> CANONICAL
CANONICAL --> CANON_VALID
CANON_VALID -->|valid| TRANSLATOR_INPUT
CANON_VALID -->|invalid| LOGGING

CANONICAL --> SAFETY
CANONICAL --> PROFILE
TRANSLATOR_INPUT --> TRANSLATE
SAFETY --> ADJUDICATE
PROFILE --> ADJUDICATE
TRANSLATE --> ADJUDICATE
ADJUDICATE --> GUIDANCE
ADJUDICATE --> DIRECTION_SELECT
GUIDANCE --> DIRECTION_SELECT

DIRECTION_SELECT --> FRAME_SELECT
FRAME_SELECT --> RESOLVE
RESOLVE --> RESOLVED_BUNDLE

RESOLVED_BUNDLE --> PITCH_CORE
PITCH_CORE --> SECTION_BUILDERS
SECTION_BUILDERS --> ASSEMBLY
ASSEMBLY --> CLEANUP
CLEANUP --> SAFETY_FILTERS
SAFETY_FILTERS --> GENERATOR
GENERATOR --> IDENTITY_RAW

IDENTITY_RAW --> EXPANSION_INPUT
EXPANSION_INPUT --> PROMPT_EXPORT
PROMPT_EXPORT --> AI_POLISH
AI_POLISH --> RESPONSE_IMPORT
RESPONSE_IMPORT --> IDENTITY_VALID
IDENTITY_VALID -->|pass| IDENTITY_FINAL
IDENTITY_VALID -->|fail / revise| AI_POLISH

IDENTITY_FINAL --> CLIENT_REVIEW
CLIENT_REVIEW --> CLIENT_SELECTION
CLIENT_SELECTION --> SELECTION_SCHEMA
SELECTION_SCHEMA --> HANDOFF_VALID
HANDOFF_VALID -->|valid| PHASE2_INPUT
HANDOFF_VALID -->|incomplete| CLIENT_REVIEW

%% =========================================================
%% PHASE 2 FLOW
%% =========================================================
PHASE2_INPUT --> IDENTITY_EXTRACT
PHASE2_INPUT --> SETTING_SYSTEM_CONTEXT
IDENTITY_EXTRACT --> INVENTION_BOUNDARY
SETTING_SYSTEM_CONTEXT --> INVENTION_BOUNDARY
INVENTION_BOUNDARY --> CONCEPT_PROMPT
CONCEPT_PROMPT --> CONCEPT_AI
CONCEPT_AI --> CONCEPT_VARIANTS
CONCEPT_VARIANTS --> NORMALIZED_CONCEPT

NORMALIZED_CONCEPT --> TITLE
NORMALIZED_CONCEPT --> PREMISE
NORMALIZED_CONCEPT --> PITCH
NORMALIZED_CONCEPT --> START
NORMALIZED_CONCEPT --> CONFLICT
NORMALIZED_CONCEPT --> PLAYERS
NORMALIZED_CONCEPT --> ENGINE
NORMALIZED_CONCEPT --> WHYNOW
NORMALIZED_CONCEPT --> FACTIONS
NORMALIZED_CONCEPT --> DISTINCTIVE
NORMALIZED_CONCEPT --> HOOK

NORMALIZED_CONCEPT --> STRUCT_VALID
STRUCT_VALID --> IDENTITY_ALIGN
IDENTITY_ALIGN --> INVENTION_VALID
INVENTION_VALID --> PLAYABLE_VALID
PLAYABLE_VALID -->|pass| CONCEPT_FINAL
PLAYABLE_VALID -->|revise| CONCEPT_AI

%% =========================================================
%% SYSTEM RECOMMENDATION FLOW
%% =========================================================
PHASE2_INPUT --> REC_INPUT
CONCEPT_FINAL --> REC_INPUT
REC_INPUT --> REC_ENGINE
REC_ENGINE --> FAMILIAR
REC_ENGINE --> ALTERNATIVES
FAMILIAR --> REC_CONTRACT
ALTERNATIVES --> REC_CONTRACT

%% =========================================================
%% EXPORT / DELIVERY FLOW
%% =========================================================
IDENTITY_FINAL --> EXPORT_INPUT
CONCEPT_FINAL --> EXPORT_INPUT
REC_CONTRACT --> EXPORT_INPUT

EXPORT_INPUT --> IDENTITY_PDF
EXPORT_INPUT --> CONCEPT_PDF
EXPORT_INPUT --> REC_PDF
IDENTITY_PDF --> DELIVERY_PACKAGE
CONCEPT_PDF --> DELIVERY_PACKAGE
REC_PDF --> DELIVERY_PACKAGE
EMAILS --> DELIVERY_PACKAGE
DELIVERY_PACKAGE --> FINAL_CLIENT

%% =========================================================
%% SUPPORT SYSTEM CONNECTIONS
%% =========================================================
CORE_LIB --> FRAME_SELECT
SYSTEM_LIB --> FRAME_SELECT
GENRE_LIB --> FRAME_SELECT
TONE_LIB --> FRAME_SELECT
ENV_LIB --> FRAME_SELECT
FRAME_DOC -.conceptual doctrine.-> CORE_LIB
FRAME_DOC -.conceptual doctrine.-> SYSTEM_LIB
FRAME_DOC -.conceptual doctrine.-> GENRE_LIB
FRAME_DOC -.conceptual doctrine.-> TONE_LIB
FRAME_DOC -.conceptual doctrine.-> ENV_LIB

VOICEMAP --> SECTION_BUILDERS
VOICEMAP --> ASSEMBLY
VOICE_RULES -.guidance.-> ASSEMBLY
VOICE_RULES -.guidance.-> AI_POLISH

SAFETY_MODEL --> SAFETY
YOUTH --> SAFETY_FILTERS
EXCLUSIONS --> ADJUDICATE
SAFETY_MODEL -.guardrails.-> IDENTITY_VALID
SAFETY_MODEL -.guardrails.-> IDENTITY_ALIGN

INTAKE_SCHEMA --> CANON_VALID
IDENTITY_SCHEMA --> IDENTITY_VALID
SELECTION_RECORD_SCHEMA --> HANDOFF_VALID
CONCEPT_OUTPUT_SCHEMA --> STRUCT_VALID
RECOMMENDATION_SCHEMA --> REC_CONTRACT

%% =========================================================
%% TEST / AUDIT CONNECTIONS
%% =========================================================
FIXTURES --> SMOKE
FIXTURES --> BATCH
FIXTURES --> E2E
FIXTURES --> AI_TEST

CORE_LIB --> SMOKE
SYSTEM_LIB --> SMOKE
FORM --> E2E
IDENTITY_RAW --> BATCH
AI_POLISH --> AI_TEST

ADJUDICATE --> AUDIT
GENERATOR --> AUDIT
IDENTITY_VALID --> AUDIT
CONCEPT_FINAL -.future audit.-> AUDIT
AUDIT --> LOGGING

DOCS -.defines intent.-> P1
DOCS -.defines planned contract.-> P2
GITHUB -.tracks implementation.-> P2
GITHUB -.tracks implementation.-> SYSREC
GITHUB -.tracks implementation.-> DELIVERY
